{
  "name": "vscode-docs",
  "version": "0.10.3",
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode-docs.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check-lfs": "node ./build/checks/check-lfs.js",
    "check-claims": "node ./build/checks/check-claims.js",
    "check-links": "node ./build/checks/check-claims.js --links",
    "check-navigation": "node ./build/checks/check-claims.js --navigation",
    "generate-manifest": "node ./build/checks/product-manifest.js",
    "check-release-note-toc": "node ./build/checks/check-release-note-toc.js",
    "check-staged-files": "node ./build/checks/check-staged-files.js",
    "lint": "eslint \"build/**/*.js\"",
    "prepare": "husky install",
    "replace-youtube-embeds": "node ./build/assets/replace-youtube-embeds.js",
    "test:replace-youtube-embeds": "node --test ./build/assets/replace-youtube-embeds.test.js",
    "test:data-variables": "node --test ./build/preview/data-variables.test.js",
    "test:tabs": "node --test ./build/preview/tabs.test.js",
    "test:cards": "node --test ./build/preview/cards.test.js",
    "test:claims": "node --test ./build/checks/check-claims.test.js ./build/checks/product-manifest.test.js ./build/checks/product-references.test.js ./build/checks/findings.test.js ./build/workflow/review-source.test.js",
    "test:links": "node --test ./build/checks/check-links.test.js",
    "test:navigation": "node --test ./build/checks/check-navigation.test.js",
    "test:audit-state": "node --test ./build/checks/audit-state.test.js ./.github/skills/daily-docs-audit/manage-state.test.js",
    "capture": "node ./build/media/capture.js",
    "test:capture": "node --test ./build/media/capture.test.js ./build/media/capture-video.test.js ./build/media/storyboard.test.js ./build/media/capture-preparation.test.js ./build/media/capture-highlights.test.js",
    "replay": "node ./build/media/replay.js",
    "test:replay": "node --test --test-name-pattern=replay ./build/media/capture.test.js",
    "test:media": "node --test ./build/media/media.test.js",
    "test:media-recipes": "node --test ./build/media/media-recipes.test.js",
    "test:sidebar": "node --test ./build/preview/generate-sidebar.test.js",
    "test:serve": "node --test ./build/preview/serve.test.js",
    "test:workbench": "node --test .github/extensions/vscode-docs-workbench/workbench.test.mjs .github/extensions/vscode-docs-workbench/server.test.mjs .github/extensions/vscode-docs-workbench/presentation.test.mjs .github/extensions/vscode-docs-workbench/archive.test.mjs .github/extensions/vscode-docs-workbench/article-workflow.test.mjs",
    "test:article-workflow": "node --test build/workflow/review-product.test.js .github/extensions/vscode-docs-workbench/article-workflow.test.mjs .github/extensions/vscode-docs-workbench/article-replay.test.mjs .github/extensions/vscode-docs-workbench/article-review.test.mjs .github/extensions/vscode-docs-workbench/feature-plans.test.mjs",
    "test:article-browser": "node --test .github/extensions/vscode-docs-workbench/article-browser.test.mjs .github/extensions/vscode-docs-workbench/article-replay.test.mjs .github/extensions/vscode-docs-workbench/article-review.test.mjs .github/extensions/vscode-docs-workbench/feature-plans.test.mjs",
    "test:review-chat": "node --test .github/extensions/vscode-docs-workbench/review-chat.test.mjs",
    "test:release-tpis": "node --test .github/extensions/vscode-docs-workbench/release-tpis.test.mjs",
    "test:pr-reviews": "node --test .github/extensions/vscode-docs-workbench/pr-reviews.test.mjs",
    "generate-sidebar": "node ./build/preview/generate-sidebar.js",
    "serve": "npm run generate-sidebar && node ./build/preview/serve.js",
    "test-release-note-toc": "node --test ./build/checks/release-note-toc.test.js"
  },
  "devDependencies": {
    "connect": "^3.7.0",
    "connect-history-api-fallback": "^1.6.0",
    "connect-livereload": "^0.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^1.7.1",
    "get-port": "^5.1.1",
    "glob": "^14.0.6",
    "gulp": "~5.0.0",
    "husky": "^7.0.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^12.3.3",
    "livereload": "^0.9.3",
    "markdown-it": "^15.0.3",
    "playwright-core": "^1.66.0-alpha-2026-11-12",
    "serve-static": "^1.16.3"
  },
  "lint-staged": {
    "*.{gif,mp4,jpg,png,GIF,MP4,JPG,PNG}": [
      "npm run check-lfs"
    ],
    "release-notes/v1_*.md": [
      "npm run check-release-note-toc"
    ]
  }
}
