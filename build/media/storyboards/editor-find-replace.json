{
  "$schema": "../../schemas/storyboard.schema.json",
  "schemaVersion": 2,
  "id": "editor-find-replace",
  "article": "docs/editing/codebasics.md",
  "channel": "insiders",
  "execution": "attended",
  "ai": "none",
  "profile": {
    "platform": "win32",
    "theme": "Dark Modern",
    "width": 1920,
    "height": 1080,
    "deviceScaleFactor": 1,
    "zoomLevel": 2,
    "wideContent": false,
    "fonts": "product-defaults"
  },
  "fixture": {
    "file": "totals.txt",
    "content": "Monthly total: 120\nYearly total: 1440\nGrand total: 1560\n"
  },
  "targets": {
    "tab": {"role": "tab", "name": "totals.txt", "exact": false, "first": true},
    "editor": {"selector": ".monaco-editor .view-lines", "first": true},
    "query": {"scope": ".find-widget", "role": "textbox", "name": "Find"},
    "toggleReplace": {"scope": ".find-widget", "role": "button", "name": "Toggle Replace"},
    "replacement": {"scope": ".find-widget", "role": "textbox", "name": "Replace"},
    "preserveCase": {"scope": ".find-widget", "role": "checkbox", "name": "Preserve Case", "exact": false},
    "count": {"selector": ".find-widget .matchesCount"}
  },
  "steps": [
    {"kind": "click", "target": "tab"},
    {"kind": "click", "target": "editor"},
    {"kind": "key", "key": "Control+Home"},
    {"kind": "key", "key": "Control+f"},
    {"kind": "fill", "target": "query", "text": "total"},
    {"kind": "click", "target": "toggleReplace"},
    {"kind": "wait-for", "target": "replacement", "state": "visible"},
    {"kind": "fill", "target": "replacement", "text": "subtotal"},
    {"kind": "check", "target": "preserveCase", "checked": true},
    {"kind": "assert", "target": "count", "text": "of 3", "match": "contains"}
  ],
  "capture": {
    "file": "editor-find-replace.png",
    "alt": "Screenshot showing the expanded Find and Replace control with Preserve Case selected and three matches for total."
  },
  "privacy": {
    "denyText": ["@", "Bearer ", "ghp_", "github_pat_"],
    "humanVisualReviewRequired": true
  }
}
