{
  "$schema": "../storyboard.schema.json",
  "schemaVersion": 2,
  "id": "editor-find-replace-stable",
  "article": "docs/editing/codebasics.md",
  "channel": "stable",
  "execution": "attended",
  "ai": "none",
  "profile": {
    "platform": "win32",
    "theme": "Dark Modern",
    "width": 1920,
    "height": 1080,
    "deviceScaleFactor": 1,
    "zoomLevel": 2,
    "wideContent": false,
    "fonts": "product-defaults"
  },
  "fixture": {
    "file": "totals.txt",
    "content": "Monthly total: 120\nYearly Total: 1440\nGrand TOTAL: 1560\n",
    "openFolder": true
  },
  "targets": {
    "tab": {"role": "tab", "name": "totals.txt", "exact": false, "first": true},
    "editor": {"selector": ".monaco-editor .view-lines", "first": true},
    "find": {"selector": ".find-widget.visible"},
    "query": {"scope": ".find-widget", "role": "textbox", "name": "Find"},
    "matchCase": {"scope": ".find-widget", "role": "checkbox", "name": "Match Case", "exact": false},
    "wholeWord": {"scope": ".find-widget", "role": "checkbox", "name": "Match Whole Word", "exact": false},
    "regex": {"scope": ".find-widget", "role": "checkbox", "name": "Use Regular Expression", "exact": false},
    "findOptions": {"selector": ".find-widget .find-part .monaco-findInput > .controls"},
    "toggleReplace": {"scope": ".find-widget", "role": "button", "name": "Toggle Replace"},
    "replacement": {"scope": ".find-widget", "role": "textbox", "name": "Replace"},
    "preserveCase": {"scope": ".find-widget", "role": "checkbox", "name": "Preserve Case", "exact": false},
    "count": {"selector": ".find-widget .matchesCount"}
  },
  "steps": [
    {"kind": "click", "target": "tab"},
    {"kind": "click", "target": "editor"},
    {"kind": "key", "key": "Control+Home"},
    {"kind": "key", "key": "Control+f"},
    {"kind": "wait-for", "target": "find", "state": "visible"},
    {"kind": "fill", "target": "query", "text": "total"},
    {"kind": "check", "target": "matchCase", "checked": false},
    {"kind": "check", "target": "wholeWord", "checked": false},
    {"kind": "check", "target": "regex", "checked": false},
    {"kind": "click", "target": "toggleReplace"},
    {"kind": "wait-for", "target": "replacement", "state": "visible"},
    {"kind": "fill", "target": "replacement", "text": "subtotal"},
    {"kind": "check", "target": "preserveCase", "checked": true},
    {"kind": "wait-for", "target": "findOptions", "state": "visible"},
    {"kind": "assert", "target": "count", "text": "of 3", "match": "contains"}
  ],
  "capture": {
    "file": "find-replace.png",
    "alt": "Screenshot showing the expanded Find and Replace control with red callouts around Match Case, Match Whole Word, Regular Expression, and Preserve Case.",
    "highlights": {
      "strokeWidth": 2,
      "targets": [
        {"target": "findOptions", "padding": 4},
        {"target": "preserveCase", "padding": 4}
      ]
    }
  },
  "privacy": {
    "denyText": ["@", "Bearer ", "ghp_", "github_pat_"],
    "humanVisualReviewRequired": true
  }
}
