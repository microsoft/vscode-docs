{
  "$schema": "../storyboard.schema.json",
  "schemaVersion": 2,
  "id": "editor-worktree-location",
  "article": "docs/agents/run/chat-view.md",
  "channel": "insiders",
  "execution": "attended",
  "ai": "none",
  "profile": {
    "platform": "win32",
    "theme": "Dark Modern",
    "width": 1920,
    "height": 1080,
    "deviceScaleFactor": 1,
    "zoomLevel": 2,
    "wideContent": false,
    "fonts": "product-defaults"
  },
  "workspace": {"entry": "sample.txt", "environment": "sample"},
  "targets": {
    "location": {"role": "button", "name": "Folder Location, update-readme-project-overview-section", "exact": true},
    "currentWorktree": {"role": "option", "name": "update-readme-project-overview-section, agents/update-readme-project-overview-section (Current)", "exact": true},
    "otherWorktree": {"role": "option", "name": "update-sample-txt-quarterly-total, agents/update-sample-txt-quarterly-total", "exact": true}
  },
  "steps": [
    {"kind": "assert", "target": "location", "text": "update-readme-project-overview-section", "match": "contains"},
    {"kind": "assert", "target": "currentWorktree", "text": "(Current)", "match": "contains"},
    {"kind": "wait-for", "target": "otherWorktree", "state": "visible"}
  ],
  "capture": {
    "mode": "prepared-session",
    "surface": "editor",
    "file": "editor-worktree-location.png",
    "alt": "Screenshot showing the Folder Location menu with two worktrees and the current worktree identified in the menu and Status Bar.",
    "highlights": {"strokeWidth": 2, "targets": [{"target": "location", "padding": -3}, {"target": "currentWorktree", "padding": -1}]}
  },
  "privacy": {"denyText": ["@", "Bearer ", "ghp_", "github_pat_"], "humanVisualReviewRequired": true}
}
