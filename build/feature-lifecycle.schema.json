{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code documentation feature lifecycle registry",
  "type": "object",
  "required": [
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "experimental",
              "preview",
              "deprecated",
              "pending-deprecation"
            ]
          },
          "trackingUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "message": {
            "type": "string",
            "pattern": "\\S",
            "description": "Optional plain-text guidance that replaces the standard deprecation sentence."
          },
          "date": {
            "type": "string",
            "pattern": "\\S",
            "description": "Optional display date used in the pending-deprecation sentence when no custom message is provided."
          },
          "moreInfoUrl": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^(https://[^/?#]+(?:[/?#]|$)|/(?!/))",
            "not": {
              "pattern": "[\\s\\u0000-\\u001f\\u007f\\\\]"
            },
            "description": "Optional HTTPS URL or root-relative published website path for deprecation details."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "deprecated",
                    "pending-deprecation"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "message": false,
                "moreInfoUrl": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "pending-deprecation"
                }
              }
            },
            "else": {
              "properties": {
                "date": false
              }
            }
          }
        ]
      }
    }
  }
}
