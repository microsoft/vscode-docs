{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code documentation feature lifecycle registry",
  "type": "object",
  "required": [
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "experimental",
              "preview"
            ]
          },
          "trackingUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
